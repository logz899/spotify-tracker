# Copy to deploy/cloudrun/gcp.env and fill in non-secret identifiers.
# gcp.env is gitignored. Secret values never go here; they live only in
# Secret Manager (see deploy/cloudrun/README.md).

# ── Google Cloud project ─────────────────────────────────────────────────────
PROJECT_ID=your-project-id
REGION=us-central1
BILLING_ACCOUNT_ID=000000-000000-000000

# ── Artifact Registry ────────────────────────────────────────────────────────
AR_REPO=spotify-song-rank

# ── Cloud Run resource names ─────────────────────────────────────────────────
API_SERVICE_NAME=spotify-api
MIGRATE_JOB_NAME=spotify-migrate
SYNC_JOB_NAME=spotify-sync
SCHEDULER_JOB_NAME=spotify-sync-every-15m

# ── Service accounts (one identity per workload) ─────────────────────────────
API_SERVICE_ACCOUNT=spotify-api@your-project-id.iam.gserviceaccount.com
MIGRATE_SERVICE_ACCOUNT=spotify-migrate@your-project-id.iam.gserviceaccount.com
SYNC_SERVICE_ACCOUNT=spotify-sync@your-project-id.iam.gserviceaccount.com
SCHEDULER_SERVICE_ACCOUNT=spotify-scheduler@your-project-id.iam.gserviceaccount.com

# ── Public application configuration ─────────────────────────────────────────
# GitHub Pages project site, including the trailing repository path.
FRONTEND_URL=https://your-github-user.github.io/your-repository/
# Browser origin only: scheme and host, no path.
CORS_ALLOWED_ORIGINS=https://your-github-user.github.io
SPOTIFY_CLIENT_ID=your-spotify-client-id
# Cloud Run API URL followed by the callback path; register it in Spotify.
SPOTIFY_REDIRECT_URI=https://your-api-url.run.app/api/v1/auth/spotify/callback
JWT_ISSUER=spotify-song-rank
JWT_AUDIENCE=spotify-song-rank-web
